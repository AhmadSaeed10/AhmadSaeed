# Production URL, used for canonical links, sitemap and Open Graph images.
SITE_URL=https://ahmadsaeed.com

# Google Tag Manager container ID. Leave as GTM-XXXXXXX to disable GTM loading.
PUBLIC_GTM_ID=GTM-XXXXXXX

# Contact form provider: "web3forms" or "formspree".
PUBLIC_FORM_PROVIDER=web3forms
# Web3Forms access key, or Formspree form ID (the part after /f/).
PUBLIC_FORM_KEY=

# Only rendered when showPhone is true in src/config/site.ts. Kept out of the repo on purpose.
CONTACT_PHONE=

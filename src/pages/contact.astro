---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { site, phone } from '@/config/site';
import { getPage } from '@/lib/content';

const page = await getPage('contact');
const d = page.data;
---
<BaseLayout title={d.seoTitle} description={d.seoDescription} ogKey="contact" stickyCta={false}>
  <section class="container wrap" aria-labelledby="contact-title">
    <div class="side">
      <p class="label">{d.eyebrow}</p>
      <h1 id="contact-title">{d.heading}</h1>
      {d.lede && <p class="lede">{d.lede}</p>}
      {site.availability.show && <p class="badge"><span class="dot" aria-hidden="true"></span>{site.availability.label}</p>}

      {d.hint && (
        <div class="hint">
          <h2 class="label">What to include in your message</h2>
          <ul>{d.hint.map((h) => <li>{h}</li>)}</ul>
        </div>
      )}

      <dl class="facts">
        <div><dt>Email</dt><dd><a href={`mailto:${site.contact.email}`} data-track="cta_click" data-track-label="contact_page_email">{site.contact.email}</a></dd></div>
        <div><dt>LinkedIn</dt><dd><a href={site.contact.linkedin} rel="noopener noreferrer" target="_blank" data-track="linkedin_click" data-track-label="contact_page">{site.contact.linkedinLabel}<span class="visually-hidden"> (opens in a new tab)</span></a></dd></div>
        <div><dt>Contra</dt><dd><a href={site.contact.contra} rel="noopener noreferrer" target="_blank" data-track="contra_click" data-track-label="contact_page">{site.contact.contraLabel}<span class="visually-hidden"> (opens in a new tab)</span></a></dd></div>
        {phone && <div><dt>Phone</dt><dd><a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></dd></div>}
        <div><dt>Location</dt><dd>{site.contact.location} ({site.contact.timezone})</dd></div>
        <div><dt>Hours</dt><dd>{site.contact.overlap}</dd></div>
        <div><dt>Work rights</dt><dd>{site.contact.workRights}</dd></div>
      </dl>
    </div>
    <div class="form-wrap">
      <ContactForm id="contact-page-form" />
    </div>
  </section>
</BaseLayout>

<script>
  // Pre-select the service when arriving from a "Request a quote" button.
  const topic = new URLSearchParams(location.search).get('topic');
  const select = document.querySelector<HTMLSelectElement>('#contact-page-form-topic');
  if (topic && select && Array.from(select.options).some((o) => o.value === topic)) select.value = topic;
</script>

<style>
  .wrap { display: grid; gap: var(--s-8); padding-block: var(--s-8) var(--section-y); }
  @media (min-width: 60rem) { .wrap { grid-template-columns: 5fr 7fr; gap: var(--s-9); } }
  .side { display: grid; gap: var(--s-5); align-content: start; }
  h1 { font-size: var(--fs-2xl); line-height: 1.05; letter-spacing: -0.025em; }
  .lede { font-size: var(--fs-md); color: var(--c-ink-2); }
  .badge { justify-self: start; display: inline-flex; align-items: center; gap: var(--s-2); padding: 0.35rem 0.85rem; border: 1px solid var(--c-rule-strong); border-radius: var(--radius-pill); font-size: var(--fs-xs); font-weight: 600; color: var(--c-ink-2); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-success); }
  .hint { padding: var(--s-5); background: var(--c-surface-2); border-radius: var(--radius); }
  .hint ul { margin-top: var(--s-3); padding-left: 1.1rem; display: grid; gap: var(--s-1); color: var(--c-ink-2); }
  .facts { display: grid; gap: var(--s-4); border-top: 1px solid var(--c-ink); padding-top: var(--s-5); }
  .facts dt { font-size: var(--fs-xs); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--c-ink-3); }
  .facts dd { color: var(--c-ink-2); }
  .facts a { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--c-ink); }
  .form-wrap { padding: clamp(1.25rem, 0.5rem + 3vw, 2.5rem); border: 1px solid var(--c-rule); border-radius: var(--radius); background: var(--c-surface); align-self: start; }
</style>

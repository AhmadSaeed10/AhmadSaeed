---
import { site } from '@/config/site';
interface Props { href?: string }
const { href = site.primaryCta.href } = Astro.props;
---
<aside class="sticky-cta" data-sticky-cta aria-label="Quick contact">
  <a href={href} class="btn btn-primary btn-lg" data-track="cta_click" data-track-label="sticky_mobile_work_with_me">
    {site.primaryCta.label} <span class="arrow" aria-hidden="true">&rarr;</span>
  </a>
</aside>

<style>
  .sticky-cta {
    position: fixed; inset: auto 0 0 0; z-index: 40;
    padding: var(--s-3) var(--gutter) calc(var(--s-3) + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--c-bg) 92%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--c-rule);
    transition: transform var(--dur) var(--ease), visibility var(--dur);
  }
  .sticky-cta .btn { width: 100%; }
  .sticky-cta[data-hidden] { transform: translateY(110%); visibility: hidden; }
  :global(html[data-menu-open]) .sticky-cta { display: none; }
  :global(body:has(.sticky-cta)) { padding-bottom: 5rem; }
  @media (min-width: 52rem) {
    .sticky-cta { display: none; }
    :global(body:has(.sticky-cta)) { padding-bottom: 0; }
  }
</style>

<script>
  // Hide the bar while the hero CTAs, the contact section or the footer are on screen.
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const targets = document.querySelectorAll('[data-hide-sticky], .site-footer');
  if (bar && targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
      bar.toggleAttribute('data-hidden', visible.size > 0);
    });
    targets.forEach((t) => io.observe(t));
  }
</script>
